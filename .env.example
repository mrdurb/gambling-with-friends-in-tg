# Задаётся что-то одно: BOT_TOKEN (настоящий вход через Telegram) или DEV_AUTH=1 (разработка).
# С обоими сразу сервер не запустится.

# Токен бота из @BotFather. Нужен для проверки подписи initData.
BOT_TOKEN=
# 1 — разрешить вход без Telegram (Authorization: dev <id>). Только для разработки.
DEV_AUTH=1
# Путь к файлу базы.
DB_PATH=casino.db
PORT=3000
